# dsh remote agent environment (example)
# Copy to /opt/dsh-agent/agent.env and generate a real token:
#   TOKEN=$(openssl rand -hex 24)
#   printf 'DSH_AGENT_TOKEN=%s\nDSH_AGENT_PORT=28431\nDSH_AGENT_HOST=0.0.0.0\n' "$TOKEN" > /opt/dsh-agent/agent.env
#   chmod 600 /opt/dsh-agent/agent.env

DSH_AGENT_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_24
DSH_AGENT_PORT=28431
DSH_AGENT_HOST=0.0.0.0
